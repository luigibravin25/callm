# Copia questo file in .env (escluso da Git). In locale le variabili si impostano con $env:
# (l'app legge solo le variabili d'ambiente); .env lo legge Docker Compose (step 9).

# API di LM Studio sull'host (in Docker: http://host.docker.internal:1234/v1)
LM_BASE_URL=http://127.0.0.1:1234/v1
# identificativo del modello restituito da GET /v1/models
LM_MODEL=google/gemma-4-e2b
# giri massimi modello-strumenti per una domanda
MAX_STEPS=5
# fuso IANA di riserva: vale se preferenze.json non ha un campo "fuso" valido
FUSO_PREDEFINITO=Europe/Rome
# file con l'ambito dell'agente (relativo a assistente-laboratorio/)
AMBITO_FILE=config/ambito.toml
# quante volte il revisore puo' rimandare una risposta non coerente all'agente (0 = mai)
MAX_REVISIONI=2
# oltre questo numero di messaggi i piu' vecchi vengono sostituiti da un riassunto
SOGLIA_RIASSUNTO=16
# messaggi recenti conservati interi (almeno; il taglio cade sempre all'inizio di un turno)
MESSAGGI_RECENTI=6
# file delle preferenze dell'utente letto dal server MCP (resource utente://preferenze), relativo a
# assistente-laboratorio/: lingua delle risposte, fuso predefinito, stile (sintetico/dettagliato)
PREFERENZE_FILE=config/preferenze.json
# servizio dell'agente (step 6): indirizzo e porta su cui ascolta python -m app.api
AGENTE_HOST=127.0.0.1
AGENTE_PORTA=8000
# indirizzo dell'agente usato dalla CLI client e dal back-end (step 7)
AGENTE_URL=http://127.0.0.1:8000
# secondi di attesa massima della CLI e del back-end per un turno (con le revisioni puo' durare minuti)
AGENTE_TIMEOUT=300

# back-end (step 7), da L6/backend: database PostgreSQL (container l6-postgres, vedi backend/README.md)
DATABASE_URL=postgresql+psycopg://assistente:<password>@127.0.0.1:5433/assistente
# database dei test (il nome deve finire con _test: i test cancellano le tabelle)
TEST_DATABASE_URL=postgresql+psycopg://assistente:<password>@127.0.0.1:5433/assistente_test
# indirizzo e porta su cui ascolta python -m app.api del back-end
BACKEND_HOST=127.0.0.1
BACKEND_PORTA=8001

# front-end (step 8), da L6/frontend: indirizzo del back-end usato dal proxy di Vite (/api → back-end)
BACKEND_URL=http://127.0.0.1:8001

# Docker Compose (step 9), da L6: docker compose up -d --build → http://127.0.0.1:8080
# credenziali del database di Compose (volume l6_dati-db, separato da l6-postgres): la password
# finisce dentro DATABASE_URL, quindi niente caratteri riservati negli URL (@ : / % #)
# in Compose gli indirizzi (LM_BASE_URL, DATABASE_URL, AGENTE_URL, host e porte) li fissa compose.yaml
POSTGRES_USER=assistente
POSTGRES_PASSWORD=<password>
POSTGRES_DB=assistente
