        ],
        "summary": "Invia Stream",
        "description": "Come l'invio di un messaggio, ma la risposta arriva a pezzi mentre il modello la scrive.\nSi salva solo a fine turno; con un errore o un client che chiude, la domanda si cancella.",
        "operationId": "invia_stream_chat__chat_id__messaggi_stream_post",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
