  "components": {
    "schemas": {
      "ChatCompleta": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "titolo": {
            "type": "string",
            "title": "Titolo"
          },
          "creata_il": {
            "type": "string",
            "format": "date-time",
            "title": "Creata Il"
          },
          "ultimo_messaggio_il": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultimo Messaggio Il"
          },
          "messaggi": {
            "items": {
              "$ref": "#/components/schemas/MessaggioChat"
            },
            "type": "array",
            "title": "Messaggi"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titolo",
          "creata_il",
          "ultimo_messaggio_il",
          "messaggi"
        ],
        "title": "ChatCompleta"
      },
      "ChatCreata": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "titolo": {
            "type": "string",
            "title": "Titolo"
          },
          "creata_il": {
            "type": "string",
            "format": "date-time",
            "title": "Creata Il"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titolo",
          "creata_il"
        ],
        "title": "ChatCreata"
      },
      "ChatInElenco": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "titolo": {
            "type": "string",
            "title": "Titolo"
          },
          "ultimo_messaggio_il": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ultimo Messaggio Il",
            "description": "ora dell'ultima risposta; null se la chat non ha ancora messaggi"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titolo",
          "ultimo_messaggio_il"
        ],
        "title": "ChatInElenco"
      },
      "Errore": {
        "properties": {
          "errore": {
            "type": "string",
            "title": "Errore",
            "description": "codice stabile, es. agente_non_raggiungibile"
          },
          "messaggio": {
            "type": "string",
            "title": "Messaggio",
            "description": "spiegazione in italiano"
          }
        },
        "type": "object",
        "required": [
          "errore",
          "messaggio"
        ],
        "title": "Errore"
      },
      "EventiFlusso": {
        "properties": {
          "fase": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventoFase"
              },
              {
                "type": "null"
              }
            ]
          },
          "testo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventoTesto"
              },
              {
                "type": "null"
              }
            ]
          },
          "strumento": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventoStrumento"
              },
              {
                "type": "null"
              }
            ]
          },
          "revisione": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventoRevisione"
              },
              {
                "type": "null"
              }
            ]
          },
          "fine": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Turno"
              },
              {
                "type": "null"
              }
            ]
          },
          "errore": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Errore"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "EventiFlusso"
      },
      "EventoFase": {
        "properties": {
          "fase": {
            "type": "string",
            "enum": [
              "pensa",
              "revisore"
            ],
            "title": "Fase",
            "description": "pensa: inizio del turno; revisore: controllo della bozza"
          }
        },
        "type": "object",
        "required": [
          "fase"
        ],
        "title": "EventoFase"
      },
      "EventoRevisione": {
        "properties": {
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "description": "perche' il revisore ha rifiutato la bozza"
          }
        },
        "type": "object",
        "required": [
          "motivo"
        ],
        "title": "EventoRevisione"
      },
      "EventoStrumento": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "argomenti": {
            "additionalProperties": true,
            "type": "object",
            "title": "Argomenti",
            "description": "argomenti della chiamata (non mostrati nella pagina)"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "argomenti"
        ],
        "title": "EventoStrumento"
      },
      "EventoTesto": {
        "properties": {
          "testo": {
            "type": "string",
            "title": "Testo",
            "description": "pezzo di testo della bozza in arrivo"
          }
        },
        "type": "object",
        "required": [
          "testo"
        ],
        "title": "EventoTesto"
      },
      "Impostazioni": {
        "properties": {
          "streaming": {
            "type": "boolean",
            "title": "Streaming",
            "description": "risposte in streaming disponibili (variabile STREAMING)"
          }
        },
        "type": "object",
        "required": [
          "streaming"
        ],
        "title": "Impostazioni"
      },
      "MessaggioChat": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "ruolo": {
            "type": "string",
            "enum": [
              "utente",
              "assistente"
            ],
            "title": "Ruolo"
          },
          "testo": {
            "type": "string",
            "title": "Testo"
          },
          "strumenti": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strumenti",
            "description": "solo per l'assistente: strumenti usati nel turno [{nome, argomenti}]"
          },
          "creato_il": {
            "type": "string",
            "format": "date-time",
            "title": "Creato Il"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ruolo",
          "testo",
          "strumenti",
          "creato_il"
        ],
        "title": "MessaggioChat"
      },
      "NuovoMessaggio": {
        "properties": {
          "testo": {
            "type": "string",
            "title": "Testo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "testo"
        ],
        "title": "NuovoMessaggio",
        "examples": [
          {
            "testo": "Che ore sono a Tokyo?"
          }
        ]
      },
      "Turno": {
        "properties": {
          "domanda": {
            "$ref": "#/components/schemas/MessaggioChat"
          },
          "risposta": {
            "$ref": "#/components/schemas/MessaggioChat"
          }
        },
        "type": "object",
        "required": [
          "domanda",
          "risposta"
        ],
        "title": "Turno"
      }
    }
  }
}
